{
  "name": "crypto-red-list",
  "version": "0.1.0",
  "private": true,
  "description": "An IUCN-style extinction-risk list for the top 500 cryptocurrencies, built on CoinMarketCap's historical listings census and backtested against 8 years of real outcomes.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "verify": "npm run check:secrets && npm run typecheck && npm run lint && npm test",
    "census": "tsx --env-file=.env scripts/fetch-census.ts",
    "calibrate": "tsx scripts/calibrate.ts",
    "redlist": "tsx --env-file=.env scripts/redlist.ts"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
